# SealedCodeBounty environment configuration
# Copy to .env and fill in values; each variable is documented inline.

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------

# RPC endpoint for the localnet/devnet cluster.
RPC_URL=http://127.0.0.1:8899

# On-chain program ID (from `anchor keys list` after `anchor build`).
PROGRAM_ID=FbqouGmrsFmoC24H3x1vX3LX9jVXhUN5zDH7RnSXba9V

# ---------------------------------------------------------------------------
# Relayer
# ---------------------------------------------------------------------------

# Fee-payer wallet keypair (solana-keygen JSON format).
FEE_PAYER_KEYPAIR_PATH=./keypair.json

# Enclave verification endpoint (mock or real).
ENCLAVE_URL=http://127.0.0.1:8443

# Pinned enclave ed25519 pubkey from Config.operators[0].
OPERATOR_PUBKEY=

# How often the relayer worker ticks (ms).
POLL_INTERVAL_MS=10000

# Path to the IDL JSON file.
IDL_PATH=target/idl/sealed_code_bounty.json

# ---------------------------------------------------------------------------
# Runner (verifier enclave)
# ---------------------------------------------------------------------------

# 64 hex chars = 32-byte master secret M (flag derivation root). REQUIRED.
SCB_MASTER_SECRET_HEX=

# 64 hex chars = X25519 secret whose public half is pinned as Config.enclave_enc_pk.
SCB_ENCLAVE_ENC_SECRET_HEX=

# Sandbox executor: stub | docker. Default: stub.
SCB_SANDBOX=stub

# Work directory for unpacked rootfs copies + exploit staging.
SCB_WORK_DIR=/tmp/scb-runner

# Global storage cap in bytes for uploaded blobs (503 when exceeded).
SCB_STORAGE_CAP_BYTES=2147483648

# TTL in seconds: uploads unregistered on-chain within this window are purged.
SCB_BLOB_TTL_SECS=1800

# Max submissions per wallet/IP inside the rate limit window.
SCB_RATE_LIMIT_MAX=5

# Rate limit window in seconds.
SCB_RATE_LIMIT_WINDOW_SECS=3600

# HTTP port for the runner's internal API (default 8443).
PORT=8443

# ---------------------------------------------------------------------------
# Packager — R2 / S3-compatible blob storage (Lane B)
# ---------------------------------------------------------------------------
# All four must be set for uploadTarball() to push to remote storage.
# When any is missing, scb-pack falls back to local relative path mode.

# S3-compatible API endpoint (R2: https://<account>.r2.cloudflarestorage.com).
SCB_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# Bucket name.
SCB_R2_BUCKET=scb-envs

# Access key ID (R2 API token access key).
SCB_R2_ACCESS_KEY_ID=

# Secret access key.
SCB_R2_SECRET_KEY=

# Region string (R2 uses "auto").
SCB_R2_REGION=auto

# ---------------------------------------------------------------------------
# Blob retention (BUILD.md "Blob retention" section)
# ---------------------------------------------------------------------------
# Bucket lifecycle rule: expire objects under scb/envs/ that have NOT been
# referenced by a manifest within 30 days of upload. Objects referenced by a
# live bounty are never expired because their manifest pins them on-chain;
# the lifecycle rule only cleans up orphaned uploads that were never
# registered (e.g., abandoned pack runs, test artifacts).
#
# Recommended R2 lifecycle rule:
#   Prefix: scb/envs/
#   Action: Delete objects after 30 days from last modification
#   (Objects referenced by active bounties should be copied to a separate
#    prefix scb/envs-live/ by the relayer during create_bounty confirmation.)
